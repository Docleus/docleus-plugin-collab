{
  "name": "@docleus/plugin-collab",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative editing with Yjs and Hocuspocus.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./shared": "./dist/shared/index.js",
    "./server": "./dist/server/index.js",
    "./editor": "./dist/editor/index.js",
    "./docleus.plugin.json": "./docleus.plugin.json"
  },
  "files": [
    "dist",
    "docleus.plugin.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint -c node_modules/@docleus/config/oxlintrc.json src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config dependency-cruiser.cjs",
    "license": "license-checker-rseidelsohn --summary --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;CC-BY-3.0;(MIT AND CC-BY-3.0)\" --excludePrivatePackages --excludePackages \"lightningcss@1.33.0\"",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps && pnpm license && pnpm test",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "@docleus/sdk": ">=0.0.1 <0.0.4"
  },
  "devDependencies": {
    "@docleus/config": "link:../docleus-core/packages/config",
    "@docleus/core-blocks": "link:../docleus-core/packages/core-blocks",
    "@docleus/core-render": "link:../docleus-core/packages/core-render",
    "@docleus/kernel": "link:../docleus-core/packages/kernel",
    "@docleus/sdk": "link:../docleus-core/packages/sdk",
    "@docleus/server": "link:../docleus-core/packages/server",
    "@docleus/testing": "link:../docleus-core/packages/testing",
    "@playwright/test": "1.64.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "happy-dom": "21.0.4",
    "kysely": "0.29.7",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "crossws": "0.4.16",
    "lib0": "0.2.119",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docleus/docleus-plugin-collab.git"
  },
  "bugs": {
    "url": "https://github.com/Docleus/docleus-plugin-collab/issues"
  },
  "homepage": "https://github.com/Docleus/docleus-plugin-collab#readme"
}
